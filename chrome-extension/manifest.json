{
  "manifest_version": 3,
  "name": "Swiggy Instamart Poll Bridge",
  "version": "1.0.0",
  "description": "Automates adding poll-selected items to your Swiggy Instamart cart from a Google Chat group order poll.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://swiggy.com/*", "https://www.swiggy.com/*"],
  "content_scripts": [
    {
      "matches": ["https://swiggy.com/instamart*", "https://www.swiggy.com/instamart*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
